@model Eticaret.Models.Order
@{
    ViewData["Title"] = "Sipariş Onayı";
}

<div class="container">
    <div class="card mb-4">
        <div class="card-body text-center py-5">
            <div class="mb-4">
                <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
            </div>
            <h1 class="mb-4">Siparişiniz Alındı!</h1>
            <p class="lead mb-4">Sipariş numaranız: <strong>@Model.Id</strong></p>
            <p class="mb-4">Siparişiniz başarıyla alındı. Siparişinizin durumunu "Siparişlerim" sayfasından takip edebilirsiniz.</p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Order" asp-action="MyOrders" class="btn btn-primary">
                    <i class="fas fa-list me-2"></i> Siparişlerim
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-home me-2"></i> Ana Sayfaya Dön
                </a>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Sipariş Detayları</h5>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h6>Sipariş Bilgileri</h6>
                    <p><strong>Sipariş No:</strong> @Model.Id</p>
                    <p><strong>Sipariş Tarihi:</strong> @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
                    <p><strong>Sipariş Durumu:</strong> <span class="badge bg-warning">@Model.Status</span></p>
                </div>
                <div class="col-md-6">
                    <h6>Teslimat Bilgileri</h6>
                    <p><strong>Teslimat Adresi:</strong> @Model.ShippingAddress</p>
                    <p><strong>Telefon:</strong> @Model.PhoneNumber</p>
                </div>
            </div>

            <h6>Sipariş Ürünleri</h6>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th>Fiyat</th>
                            <th>Adet</th>
                            <th class="text-end">Toplam</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td>@item.Product.Name</td>
                                <td>@item.UnitPrice.ToString("C")</td>
                                <td>@item.Quantity</td>
                                <td class="text-end">@item.TotalPrice.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Ara Toplam:</th>
                            <th class="text-end">@Model.TotalAmount.ToString("C")</th>
                        </tr>
                        <tr>
                            <th colspan="3" class="text-end">Kargo:</th>
                            <th class="text-end">Ücretsiz</th>
                        </tr>
                        <tr>
                            <th colspan="3" class="text-end">Toplam:</th>
                            <th class="text-end text-primary">@Model.TotalAmount.ToString("C")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div> 