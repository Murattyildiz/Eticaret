@model Eticaret.Models.Product
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <h1 class="mt-4">Yeni Ürün Ekle</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Products">Ürünler</a></li>
        <li class="breadcrumb-item active">Yeni Ürün Ekle</li>
    </ol>
    
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-plus me-1"></i>
            Ürün Bilgileri
        </div>
        <div class="card-body">
            <form asp-action="ProductCreate" asp-controller="Admin" method="post" enctype="multipart/form-data" id="productForm">
                <div asp-validation-summary="All" class="text-danger"></div>
                
                <div class="row">
                    <div class="col-md-8">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">Ürün Adı</label>
                                <input asp-for="Name" class="form-control" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label">Kategori</label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                                    <option value="">-- Kategori Seçin --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label">Fiyat</label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" required />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Stock" class="form-label">Stok</label>
                                <input asp-for="Stock" class="form-control" type="number" min="0" required />
                                <span asp-validation-for="Stock" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Ürün Resmi</label>
                            <input type="file" name="Image" id="Image" class="form-control" accept="image/*" />
                            <div class="mt-3">
                                <img id="imagePreview" src="~/images/no-image.jpg" alt="Resim Önizleme" class="img-fluid img-thumbnail" style="max-height: 250px;" />
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" id="submitButton">
                        <i class="fas fa-save me-1"></i> Kaydet
                    </button>
                    <a asp-action="Products" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i> İptal
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            var form = $('#productForm');
            var submitButton = $('#submitButton');

            // Form submit öncesi kontrol
            form.on('submit', function(e) {
                e.preventDefault();
                
                var categoryId = $('#CategoryId').val();
                if (!categoryId) {
                    alert('Lütfen bir kategori seçin');
                    return false;
                }

                var price = $('#Price').val();
                if (!price || parseFloat(price) <= 0) {
                    alert('Lütfen geçerli bir fiyat girin');
                    return false;
                }

                var stock = $('#Stock').val();
                if (!stock || parseInt(stock) < 0) {
                    alert('Lütfen geçerli bir stok miktarı girin');
                    return false;
                }

                // Form geçerli ise submit et
                submitButton.prop('disabled', true);
                this.submit();
            });

            // Resim önizleme
            $('#Image').on('change', function(e) {
                if (e.target.files && e.target.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        $('#imagePreview').attr('src', e.target.result);
                    }
                    reader.readAsDataURL(e.target.files[0]);
                }
            });
        });
    </script>
} 