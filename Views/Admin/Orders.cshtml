@model IEnumerable<Eticaret.Models.Order>

@{
    ViewData["Title"] = "Siparişler";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Siparişler</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item active">Siparişler</li>
    </ol>
    
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-shopping-cart me-1"></i>
            Sipariş Listesi
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Sipariş No</th>
                        <th>Müşteri</th>
                        <th>Tarih</th>
                        <th>Toplam Tutar</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.User.FullName</td>
                            <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@order.TotalAmount.ToString("C")</td>
                            <td>
                                <span class="badge bg-@(GetStatusBadgeClass(order.Status))">
                                    @GetStatusText(order.Status)
                                </span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i> Detay
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // DataTable initialization
        $(document).ready(function () {
            $('.table').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/tr.json'
                },
                order: [[2, 'desc']] // Sort by date (3rd column) descending
            });
        });
    </script>
}

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "beklemede" => "warning",
            "bekliyor" => "warning",
            "hazırlanıyor" => "info",
            "işleniyor" => "info",
            "kargoya verildi" => "primary",
            "tamamlandı" => "success",
            "iptal edildi" => "danger",
            _ => "secondary"
        };
    }
    
    string GetStatusText(string status)
    {
        return string.IsNullOrEmpty(status) ? "Beklemede" : status;
    }
} 