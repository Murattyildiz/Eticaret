@model Eticaret.Models.ContactViewModel
@{
    ViewData["Title"] = "İletişim";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="text-center mb-4">İletişim</h1>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">İletişim Bilgileri</h5>
                            <hr>
                            <div class="d-flex mb-3">
                                <i class="fas fa-map-marker-alt text-primary fa-2x me-3"></i>
                                <div>
                                    <h6 class="mb-1">Adres</h6>
                                    <p class="mb-0">[Şirket Adresi]</p>
                                </div>
                            </div>
                            <div class="d-flex mb-3">
                                <i class="fas fa-phone-alt text-primary fa-2x me-3"></i>
                                <div>
                                    <h6 class="mb-1">Telefon</h6>
                                    <p class="mb-0">[Telefon Numarası]</p>
                                </div>
                            </div>
                            <div class="d-flex mb-3">
                                <i class="fas fa-envelope text-primary fa-2x me-3"></i>
                                <div>
                                    <h6 class="mb-1">E-posta</h6>
                                    <p class="mb-0">[E-posta Adresi]</p>
                                </div>
                            </div>
                            <div class="d-flex">
                                <i class="fas fa-clock text-primary fa-2x me-3"></i>
                                <div>
                                    <h6 class="mb-1">Çalışma Saatleri</h6>
                                    <p class="mb-0">Pazartesi - Cumartesi: 09:00 - 18:00</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">İletişim Formu</h5>
                            <hr>
                            <form asp-action="Contact" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label"></label>
                                    <input asp-for="Name" class="form-control" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Subject" class="form-label"></label>
                                    <input asp-for="Subject" class="form-control" />
                                    <span asp-validation-for="Subject" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Message" class="form-label"></label>
                                    <textarea asp-for="Message" class="form-control" rows="5"></textarea>
                                    <span asp-validation-for="Message" class="text-danger"></span>
                                </div>

                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-paper-plane me-2"></i> Gönder
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="card-title">Konum</h5>
                    <hr>
                    <div class="ratio ratio-16x9">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3019.9573754793535!2d29.021535815414498!3d41.107145279291424!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cab5c7b4b0b9c3%3A0x7c3f1e5c4a0c6e0b!2zxLBzdGFuYnVs!5e0!3m2!1str!2str!4v1629789145684!5m2!1str!2str" 
                                style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 