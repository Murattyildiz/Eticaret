@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="text-center mb-4">Hakkımızda</h1>
            
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Biz Kimiz?</h5>
                    <p class="card-text">
                        [Şirket Adı] olarak, müşterilerimize en kaliteli ürünleri en uygun fiyatlarla sunmayı hedefliyoruz. 
                        20XX yılında kurulan şirketimiz, sürekli büyüyen ürün yelpazesi ve müşteri odaklı hizmet anlayışıyla 
                        sektörde öncü konuma gelmeyi başarmıştır.
                    </p>

                    <h5 class="card-title mt-4">Misyonumuz</h5>
                    <p class="card-text">
                        Müşterilerimize en iyi alışveriş deneyimini sunmak, kaliteli ürünleri uygun fiyatlarla ulaştırmak ve 
                        satış sonrası destek ile tam müşteri memnuniyeti sağlamak.
                    </p>

                    <h5 class="card-title mt-4">Vizyonumuz</h5>
                    <p class="card-text">
                        E-ticaret sektöründe güvenilir, yenilikçi ve lider bir marka olmak. Müşterilerimizin ihtiyaçlarını 
                        en iyi şekilde anlayarak, onlara özel çözümler sunmak.
                    </p>

                    <h5 class="card-title mt-4">Değerlerimiz</h5>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-check text-success me-2"></i> Müşteri Memnuniyeti</li>
                        <li><i class="fas fa-check text-success me-2"></i> Kalite</li>
                        <li><i class="fas fa-check text-success me-2"></i> Güvenilirlik</li>
                        <li><i class="fas fa-check text-success me-2"></i> Yenilikçilik</li>
                        <li><i class="fas fa-check text-success me-2"></i> Sürdürülebilirlik</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="card-title">Neden Biz?</h5>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-shipping-fast text-primary fa-2x me-3"></i>
                                <div>
                                    <h6>Hızlı Teslimat</h6>
                                    <p class="mb-0">Siparişleriniz en kısa sürede adresinize teslim edilir.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-medal text-primary fa-2x me-3"></i>
                                <div>
                                    <h6>Kaliteli Ürünler</h6>
                                    <p class="mb-0">Sadece en kaliteli ürünleri sizlerle buluşturuyoruz.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-headset text-primary fa-2x me-3"></i>
                                <div>
                                    <h6>7/24 Destek</h6>
                                    <p class="mb-0">Müşteri hizmetlerimiz her zaman yanınızda.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-shield-alt text-primary fa-2x me-3"></i>
                                <div>
                                    <h6>Güvenli Alışveriş</h6>
                                    <p class="mb-0">SSL sertifikası ile güvenli ödeme imkanı.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 