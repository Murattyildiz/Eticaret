@model IEnumerable<Eticaret.Models.CartItem>

@{
    ViewData["Title"] = "Alışveriş Sepeti";
    decimal totalPrice = 0;
}

<div class="container">
    <h1 class="mb-4">Alışveriş Sepeti</h1>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Sepet Ürünleri</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Ürün</th>
                                        <th>Fiyat</th>
                                        <th>Adet</th>
                                        <th>Toplam</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        decimal itemTotal = item.Product.Price * item.Quantity;
                                        totalPrice += itemTotal;

                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                                    {
                                                        <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="img-thumbnail me-3" style="width: 60px;">
                                                    }
                                                    else
                                                    {
                                                        <img src="~/images/no-image.jpg" alt="Ürün görseli bulunamadı" class="img-thumbnail me-3" style="width: 60px;">
                                                    }
                                                    <div>
                                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">
                                                            @item.Product.Name
                                                        </a>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@item.Product.Price.ToString("C")</td>
                                            <td style="width: 120px;">
                                                <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm me-2" style="width: 60px;" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                        <i class="fas fa-sync-alt"></i>
                                                    </button>
                                                </form>
                                            </td>
                                            <td>@itemTotal.ToString("C")</td>
                                            <td>
                                                <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mb-4">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i> Alışverişe Devam Et
                    </a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Sipariş Özeti</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span>Ara Toplam:</span>
                            <span>@totalPrice.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Kargo:</span>
                            <span>Ücretsiz</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold">Toplam:</span>
                            <span class="fw-bold text-primary">@totalPrice.ToString("C")</span>
                        </div>
                        <div class="d-grid">
                            <a asp-controller="Order" asp-action="Checkout" class="btn btn-success">
                                <i class="fas fa-credit-card me-2"></i> Ödemeye Geç
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-cart fa-5x mb-4 text-muted"></i>
            <h3>Sepetiniz Boş</h3>
            <p class="lead mb-4">Sepetinizde ürün bulunmamaktadır.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-shopping-bag me-2"></i> Alışverişe Başla
            </a>
        </div>
    }
</div> 